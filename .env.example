# Tim 学习助手 - 环境变量示例（复制为 .env 并填入真实值，.env 不提交仓库）
# 复制本文件为 .env 后填写，切勿将真实密钥提交到版本库

# ===== OCR 提供商 =====
# 错题识别统一使用百度智能云 OCR（仅需配置下方百度凭证）
OCR_PROVIDER=baidu

# ===== 百度智能云 OCR 凭证（access_token 流程：API Key + Secret Key） =====
# 在百度AI开放平台/智能云创建 OCR 应用后获得，切勿将真实值提交到版本库
BAIDU_OCR_API_KEY=your_baidu_api_key_here
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key_here
# 可选：自定义网关地址 / 接口路径 / 超时
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com
# 默认使用「试卷分析与识别」(doc_analysis) 接口：原生公式识别 + 版面分析
BAIDU_OCR_API=/rest/2.0/ocr/v1/doc_analysis
# 是否开启公式识别（true/false），开启后返回 LaTeX 公式
BAIDU_OCR_RECG_FORMULA=true
BAIDU_OCR_TIMEOUT=10
